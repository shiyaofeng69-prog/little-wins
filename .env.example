# Example environment for Little Wins
# Copy to `.env` at the repo root for backend and `.env.local` for frontend

# Backend (.env)
RAILWAY_ENVIRONMENT=development
PORT=5000
SECRET_KEY=
# Required: set a strong random value before deploying
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# Feature flags (0=disabled, 1=enabled)
# Email registration/login is enabled by default. Set to 0 when a deployment
# should only expose Google OAuth or the private local account.
ENABLE_EMAIL_AUTH=1
ENABLE_GOOGLE_OAUTH=0
ENABLE_MOOD_MUSIC=0
ENABLE_LEGACY_FEATURES=0

# Local login. For public deployments, set a strong password. Passwordless
# mode is only appropriate for localhost or a trusted private network.
LOCAL_ACCESS_PASSWORD=
ALLOW_PASSWORDLESS_LOCAL_LOGIN=1

# Exact number of trusted reverse-proxy hops (0 for direct access).
TRUST_PROXY_HOPS=0

# Self-host defaults
DEFAULT_SELF_HOST_ID=selfhost_default_user
SELFHOST_USER_NAME=Me
SELFHOST_USER_EMAIL=

# Database (optional; legacy filename is retained for data compatibility)
# DATABASE_PATH=

# Google OAuth (only if ENABLE_GOOGLE_OAUTH=1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Web3 removed

# Mood music (only if ENABLE_MOOD_MUSIC=1)
JAMENDO_CLIENT_ID=

# Frontend (.env.local)
VITE_API_URL=http://localhost:5000
# If enabling Google OAuth, also set on the frontend
# VITE_GOOGLE_CLIENT_ID=
