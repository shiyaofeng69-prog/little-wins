# Docker Environment Configuration for Little Wins
# Copy this file to .env in the project root to customize your deployment

# Security Settings (REQUIRED: generate independent random values, for example
# with `openssl rand -hex 32`; production refuses blank or placeholder secrets.)
SECRET_KEY=
JWT_SECRET=

# Feature Flags (0=disabled, 1=enabled)
ENABLE_GOOGLE_OAUTH=0
ENABLE_MOOD_MUSIC=0
ENABLE_LEGACY_FEATURES=0

# Keep passwordless mode disabled on every public or shared network.
LOCAL_ACCESS_PASSWORD=
ALLOW_PASSWORDLESS_LOCAL_LOGIN=0
TRUST_PROXY_HOPS=1

# Self-host Configuration
DEFAULT_SELF_HOST_ID=selfhost_default_user
SELFHOST_USER_NAME=Me
SELFHOST_USER_EMAIL=

# CORS Origins (update for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Google OAuth Settings (only needed if ENABLE_GOOGLE_OAUTH=1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Mood music settings (only needed if ENABLE_MOOD_MUSIC=1)
JAMENDO_CLIENT_ID=

# Web3 removed

# Database Path (legacy filename is retained for data compatibility)
# DATABASE_PATH=/app/data/nightlio.db

# Flask Environment
FLASK_ENV=production
RAILWAY_ENVIRONMENT=production

# Port Configuration (usually don't need to change)
# PORT=5000
